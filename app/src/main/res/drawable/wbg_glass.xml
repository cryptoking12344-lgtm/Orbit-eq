<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- frosted body -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#38FFFFFF" />
            <stroke android:width="1dp" android:color="#73FFFFFF" />
            <corners android:radius="28dp" />
        </shape>
    </item>
    <!-- light catching the top edge -->
    <item android:bottom="40dp">
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:endColor="#00FFFFFF" android:startColor="#38FFFFFF" />
            <corners android:topLeftRadius="28dp" android:topRightRadius="28dp" />
        </shape>
    </item>
</layer-list>
