<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingTop="14dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textColor="@color/text"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtHeaderSub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/global_off"
                android:textColor="@color/text_dim"
                android:textSize="12sp" />
        </LinearLayout>

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switchGlobal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/system_wide"
            android:textColor="@color/text" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- ===================== EQUALIZER PAGE ===================== -->
        <ScrollView
            android:id="@+id/pageEq"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="4dp"
                android:paddingEnd="16dp">

                <com.google.android.material.card.MaterialCardView
                    style="@style/OrbitCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <com.ck.orbiteq.ui.VisualizerView
                            android:id="@+id/vizGlobal"
                            android:layout_width="match_parent"
                            android:layout_height="84dp" />

                        <TextView
                            android:id="@+id/txtVizHint"
                            style="@style/Label"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="@string/viz_hint"
                            android:textSize="12sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    style="@style/OrbitCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                style="@style/SectionTitle"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/equalizer" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnReset"
                                style="@style/Widget.Material3.Button.TextButton"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/reset" />
                        </LinearLayout>

                        <com.ck.orbiteq.ui.EqCurveView
                            android:id="@+id/eqCurve"
                            android:layout_width="match_parent"
                            android:layout_height="230dp"
                            android:layout_marginTop="4dp" />

                        <HorizontalScrollView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:scrollbars="none">

                            <com.google.android.material.chip.ChipGroup
                                android:id="@+id/chipsPresets"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                app:singleLine="true" />
                        </HorizontalScrollView>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    style="@style/OrbitCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            style="@style/SectionTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/effects" />

                        <TextView
                            android:id="@+id/lblBass"
                            style="@style/Label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp" />

                        <com.google.android.material.slider.Slider
                            android:id="@+id/sliderBass"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:value="0"
                            android:valueFrom="0"
                            android:valueTo="1"
                            app:labelBehavior="gone" />

                        <TextView
                            android:id="@+id/lblSpatial"
                            style="@style/Label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />

                        <com.google.android.material.slider.Slider
                            android:id="@+id/sliderSpatial"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:value="0"
                            android:valueFrom="0"
                            android:valueTo="1"
                            app:labelBehavior="gone" />

                        <TextView
                            android:id="@+id/lblLoud"
                            style="@style/Label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />

                        <com.google.android.material.slider.Slider
                            android:id="@+id/sliderLoud"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:value="0"
                            android:valueFrom="0"
                            android:valueTo="8"
                            app:labelBehavior="gone" />

                        <TextView
                            android:id="@+id/lblPreamp"
                            style="@style/Label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />

                        <com.google.android.material.slider.Slider
                            android:id="@+id/sliderPreamp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:value="0"
                            android:valueFrom="-12"
                            android:valueTo="6"
                            app:labelBehavior="gone" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    style="@style/OrbitCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            style="@style/SectionTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/reverb" />

                        <com.google.android.material.chip.ChipGroup
                            android:id="@+id/chipsReverb"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:id="@+id/txtStatus"
                    style="@style/Label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginEnd="6dp"
                    android:textSize="12sp" />
            </LinearLayout>
        </ScrollView>

        <!-- ===================== 8D PLAYER PAGE ===================== -->
        <ScrollView
            android:id="@+id/pagePlayer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="24dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="4dp"
                android:paddingEnd="16dp">

                <!-- YOUTUBE -->
                <com.google.android.material.card.MaterialCardView
                    style="@style/OrbitCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="14dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            style="@style/SectionTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/yt_title" />

                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.Material3.TextInputLayout.OutlinedBox.Dense"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:hint="@string/yt_hint"
                            app:endIconMode="clear_text">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/editYt"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:imeOptions="actionGo"
                                android:inputType="textUri"
                                android:singleLine="true" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:orientation="horizontal">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnYtPaste"
                                style="@style/Widget.Material3.Button.OutlinedButton"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/yt_paste" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnYtPlay"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="10dp"
                                android:layout_weight="1"
                                android:text="@string/play"
                                app:icon="@drawable/ic_play" />
                        </LinearLayout>

                        <com.google.android.material.progressindicator.LinearProgressIndicator
                            android:id="@+id/progressYt"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:visibility="gone"
                            app:trackCornerRadius="4dp" />

                        <TextView
                            android:id="@+id/txtYtStatus"
                            style="@style/Label"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="@string/yt_sub"
                            android:textSize="12sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    style="@style/OrbitCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <com.ck.orbiteq.ui.VisualizerView
                            android:id="@+id/vizPlayer"
                            android:layout_width="match_parent"
                            android:layout_height="170dp" />

                        <TextView
                            android:id="@+id/txtTrack"
                            style="@style/SectionTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:ellipsize="end"
                            android:singleLine="true"
                            android:text="@string/no_song" />

                        <TextView
                            android:id="@+id/txtTrackSub"
                            style="@style/Label"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/open_hint" />

                        <com.google.android.material.slider.Slider
                            android:id="@+id/sliderSeek"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:value="0"
                            android:valueFrom="0"
                            android:valueTo="1"
                            app:labelBehavior="gone" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp">

                            <TextView
                                android:id="@+id/txtPos"
                                style="@style/Label"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="0:00" />

                            <TextView
                                android:id="@+id/txtDur"
                                style="@style/Label"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0:00" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:gravity="center"
                            android:orientation="horizontal">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnOpen"
                                style="@style/Widget.Material3.Button.OutlinedButton"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/open" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnPlay"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="10dp"
                                android:text="@string/play"
                                app:icon="@drawable/ic_play" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnStop"
                                style="@style/Widget.Material3.Button.OutlinedButton"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="10dp"
                                android:text="@string/stop" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- SOUND MODE: Off / Theater / 360 -->
                <com.google.android.material.card.MaterialCardView
                    style="@style/OrbitCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            style="@style/SectionTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/sound_mode" />

                        <com.google.android.material.button.MaterialButtonToggleGroup
                            android:id="@+id/toggleMode"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            app:selectionRequired="true"
                            app:singleSelection="true">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/modeOff"
                                style="@style/Widget.Material3.Button.OutlinedButton"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/mode_off" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/modeTheater"
                                style="@style/Widget.Material3.Button.OutlinedButton"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/theater" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/mode360"
                                style="@style/Widget.Material3.Button.OutlinedButton"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/mode_360" />
                        </com.google.android.material.button.MaterialButtonToggleGroup>

                        <TextView
                            android:id="@+id/txtModeSub"
                            style="@style/Label"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp" />

                        <!-- shown for Theater and 360 -->
                        <LinearLayout
                            android:id="@+id/panelSpatial"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <com.ck.orbiteq.ui.SpeakerMapView
                                android:id="@+id/speakerMap"
                                android:layout_width="match_parent"
                                android:layout_height="260dp"
                                android:layout_marginTop="8dp" />

                            <TextView
                                android:id="@+id/txtTestNow"
                                style="@style/Label"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center"
                                android:text="@string/test_hint" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnSpeakerTest"
                                style="@style/Widget.Material3.Button.OutlinedButton"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center_horizontal"
                                android:layout_marginTop="6dp"
                                android:text="@string/test_all" />

                            <!-- Theater controls -->
                            <LinearLayout
                                android:id="@+id/panelTheater"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical">

                                <TextView
                                    style="@style/Label"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="12dp"
                                    android:text="@string/room" />

                                <com.google.android.material.chip.ChipGroup
                                    android:id="@+id/chipsRoom"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content" />

                                <TextView
                                    android:id="@+id/lblImmersion"
                                    style="@style/Label"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="8dp" />

                                <com.google.android.material.slider.Slider
                                    android:id="@+id/sliderImmersion"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:value="0.5"
                                    android:valueFrom="0"
                                    android:valueTo="1"
                                    app:labelBehavior="gone" />

                                <TextView
                                    android:id="@+id/lblVocal"
                                    style="@style/Label"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content" />

                                <com.google.android.material.slider.Slider
                                    android:id="@+id/sliderVocal"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:value="0.6"
                                    android:valueFrom="0"
                                    android:valueTo="1"
                                    app:labelBehavior="gone" />
                            </LinearLayout>

                            <!-- 360 controls -->
                            <LinearLayout
                                android:id="@+id/panel360"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/lblWrap"
                                    style="@style/Label"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="12dp" />

                                <com.google.android.material.slider.Slider
                                    android:id="@+id/sliderWrap"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:value="0.7"
                                    android:valueFrom="0"
                                    android:valueTo="1"
                                    app:labelBehavior="gone" />

                                <TextView
                                    android:id="@+id/lblHeight"
                                    style="@style/Label"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content" />

                                <com.google.android.material.slider.Slider
                                    android:id="@+id/sliderHeight"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:value="0.5"
                                    android:valueFrom="0"
                                    android:valueTo="1"
                                    app:labelBehavior="gone" />

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:gravity="center_vertical"
                                    android:orientation="horizontal">

                                    <TextView
                                        android:id="@+id/lblRotate"
                                        style="@style/Label"
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1" />

                                    <com.google.android.material.button.MaterialButton
                                        android:id="@+id/btnResetRotate"
                                        style="@style/Widget.Material3.Button.TextButton"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="@string/face_front" />
                                </LinearLayout>

                                <com.google.android.material.slider.Slider
                                    android:id="@+id/sliderRotate"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:stepSize="5"
                                    android:value="0"
                                    android:valueFrom="-180"
                                    android:valueTo="180"
                                    app:labelBehavior="gone" />

                                <TextView
                                    style="@style/Label"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/head_size" />

                                <com.google.android.material.chip.ChipGroup
                                    android:id="@+id/chipsHead"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content" />
                            </LinearLayout>

                            <!-- shared -->
                            <TextView
                                android:id="@+id/lblSub"
                                style="@style/Label"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp" />

                            <com.google.android.material.slider.Slider
                                android:id="@+id/sliderSub"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:value="0.4"
                                android:valueFrom="0"
                                android:valueTo="1"
                                app:labelBehavior="gone" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:orientation="vertical">

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="@string/xm4_fix"
                                        android:textColor="@color/text"
                                        android:textSize="14sp" />

                                    <TextView
                                        style="@style/Label"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="@string/xm4_fix_sub"
                                        android:textSize="12sp" />
                                </LinearLayout>

                                <com.google.android.material.materialswitch.MaterialSwitch
                                    android:id="@+id/switchHpFix"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content" />
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    style="@style/Label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginEnd="6dp"
                    android:text="@string/player_hint"
                    android:textSize="12sp" />
            </LinearLayout>
        </ScrollView>

        <!-- ===================== HEADPHONES PAGE ===================== -->
        <ScrollView
            android:id="@+id/pageProfiles"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="24dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="4dp"
                android:paddingEnd="16dp">

                <com.google.android.material.card.MaterialCardView
                    style="@style/OrbitCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            style="@style/SectionTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/headphones" />

                        <TextView
                            android:id="@+id/txtDevice"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:textColor="@color/text"
                            android:textSize="14sp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnLinkDevice"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="@string/link_device"
                            app:icon="@drawable/ic_headphones" />

                        <TextView
                            android:id="@+id/txtLinks"
                            style="@style/Label"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    style="@style/OrbitCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            style="@style/SectionTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/hp_starting" />

                        <TextView
                            style="@style/Label"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/hp_starting_sub" />

                        <com.google.android.material.chip.ChipGroup
                            android:id="@+id/chipsHeadphones"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    style="@style/OrbitCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                style="@style/SectionTitle"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/my_profiles" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnSaveProfile"
                                style="@style/Widget.Material3.Button.TextButton"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/save_current" />
                        </LinearLayout>

                        <com.google.android.material.chip.ChipGroup
                            android:id="@+id/chipsCustom"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp" />

                        <TextView
                            android:id="@+id/txtNoProfiles"
                            style="@style/Label"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/no_profiles" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </ScrollView>
    </FrameLayout>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        app:menu="@menu/bottom_nav" />
</LinearLayout>
